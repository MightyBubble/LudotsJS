{
  "name": "ParticipantTopology",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "config_id": {
      "type": "string",
      "description": "\u53c2\u4e0e\u8005\u62d3\u6251\u914d\u7f6e\u552f\u4e00\u6807\u8bc6"
    },
    "label": {
      "type": "string",
      "description": "\u663e\u793a\u540d\u79f0"
    },
    "map_id": {
      "type": "string",
      "description": "\u5f15\u7528 MapConfig.map_id"
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "project",
        "workspace"
      ],
      "default": "project"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "team_id": {
            "type": "integer",
            "minimum": 1
          },
          "representative_instance_id": {
            "type": "string"
          }
        },
        "required": [
          "team_id",
          "representative_instance_id"
        ]
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "player_id": {
            "type": "integer",
            "minimum": 1
          },
          "team_id": {
            "type": "integer",
            "minimum": 1
          },
          "representative_instance_id": {
            "type": "string"
          }
        },
        "required": [
          "player_id",
          "team_id",
          "representative_instance_id"
        ]
      }
    },
    "participant_relationships": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "team_a": {
                "type": "integer",
                "minimum": 1
              },
              "team_b": {
                "type": "integer",
                "minimum": 1
              },
              "type_id": {
                "type": "string"
              },
              "attitude": {
                "type": "string"
              },
              "symmetric": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "team_a",
              "team_b",
              "type_id",
              "attitude",
              "symmetric"
            ]
          }
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "player_a": {
                "type": "integer",
                "minimum": 1
              },
              "player_b": {
                "type": "integer",
                "minimum": 1
              },
              "type_id": {
                "type": "string"
              },
              "symmetric": {
                "type": "boolean",
                "default": true
              }
            },
            "required": [
              "player_a",
              "player_b",
              "type_id",
              "symmetric"
            ]
          }
        },
        "player_teams": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "player_id": {
                "type": "integer",
                "minimum": 1
              },
              "team_id": {
                "type": "integer",
                "minimum": 1
              },
              "type_id": {
                "type": "string"
              },
              "attitude": {
                "type": "string"
              },
              "symmetric": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "player_id",
              "team_id",
              "type_id",
              "attitude",
              "symmetric"
            ]
          }
        }
      },
      "required": [
        "teams",
        "players",
        "player_teams"
      ]
    }
  },
  "required": [
    "config_id",
    "map_id",
    "teams",
    "players",
    "participant_relationships"
  ]
}