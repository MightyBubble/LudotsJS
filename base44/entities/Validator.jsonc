{
  "name": "Validator",
  "type": "object",
  "properties": {
    "validator_id": {
      "type": "string",
      "description": "\u9a8c\u8bc1\u5668\u552f\u4e00\u6807\u8bc6\u7b26"
    },
    "name": {
      "type": "string",
      "description": "\u9a8c\u8bc1\u5668\u663e\u793a\u540d\u79f0"
    },
    "description": {
      "type": "string",
      "description": "\u9a8c\u8bc1\u5668\u63cf\u8ff0"
    },
    "validator_type": {
      "type": "string",
      "enum": [
        "entity_check",
        "entity_compare",
        "combine",
        "function_graph"
      ],
      "description": "\u9a8c\u8bc1\u5668\u7c7b\u578b"
    },
    "entity_check_config": {
      "type": "object",
      "description": "\u5b9e\u4f53\u68c0\u67e5\u914d\u7f6e",
      "properties": {
        "source_entity": {
          "type": "string",
          "enum": [
            "source",
            "target"
          ],
          "default": "source",
          "description": "\u6e90\u5b9e\u4f53"
        },
        "check_type": {
          "type": "string",
          "enum": [
            "has_tag",
            "has_any_tags",
            "has_all_tags",
            "is_prototype",
            "has_attribute",
            "has_relation",
            "function_graph"
          ],
          "description": "\u68c0\u67e5\u7c7b\u578b"
        },
        "tag_path": {
          "type": "string"
        },
        "tag_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prototype_id": {
          "type": "string"
        },
        "attribute_id": {
          "type": "string"
        },
        "relation_id": {
          "type": "string"
        },
        "function_graph_id": {
          "type": "string"
        },
        "parameter_bindings": {
          "type": "object",
          "description": "\u51fd\u6570\u56fe\u53c2\u6570\u7ed1\u5b9a"
        }
      }
    },
    "entity_compare_config": {
      "type": "object",
      "description": "\u5b9e\u4f53\u6bd4\u8f83\u914d\u7f6e",
      "properties": {
        "source_entity": {
          "type": "string",
          "enum": [
            "source",
            "target"
          ],
          "default": "source",
          "description": "\u6e90\u5b9e\u4f53\uff08\u6bd4\u8f83\u5de6\u8fb9\uff09"
        },
        "compare_type": {
          "type": "string",
          "enum": [
            "attribute_value",
            "tag_count",
            "relation_count",
            "function_graph"
          ],
          "description": "\u6bd4\u8f83\u7c7b\u578b"
        },
        "attribute_id": {
          "type": "string"
        },
        "attribute_key": {
          "type": "string"
        },
        "tag_path": {
          "type": "string"
        },
        "relation_id": {
          "type": "string"
        },
        "operator": {
          "type": "string",
          "enum": [
            "eq",
            "neq",
            "gt",
            "lt",
            "gte",
            "lte"
          ],
          "description": "\u6bd4\u8f83\u64cd\u4f5c\u7b26"
        },
        "value_source": {
          "type": "string",
          "enum": [
            "literal",
            "constant",
            "attribute_key"
          ],
          "default": "literal",
          "description": "\u6bd4\u8f83\u503c\u6765\u6e90\uff1a\u56fa\u5b9a\u503c\u3001\u5168\u5c40\u5e38\u91cf\u3001\u5c5e\u6027\u952e"
        },
        "compare_value": {
          "type": "number",
          "description": "\u6bd4\u8f83\u503c\uff08literal\u6a21\u5f0f\uff09"
        },
        "constant_key": {
          "type": "string",
          "description": "\u5e38\u91cf\u952e\uff08constant\u6a21\u5f0f\uff09"
        },
        "target_entity": {
          "type": "string",
          "enum": [
            "source",
            "target"
          ],
          "description": "\u76ee\u6807\u5b9e\u4f53\uff08attribute_key\u6a21\u5f0f\uff0c\u6bd4\u8f83\u53f3\u8fb9\uff09"
        },
        "target_attribute_id": {
          "type": "string",
          "description": "\u76ee\u6807\u5c5e\u6027ID\uff08attribute_key\u6a21\u5f0f\uff09"
        },
        "target_attribute_key": {
          "type": "string",
          "description": "\u76ee\u6807\u5c5e\u6027\u952e\uff08attribute_key\u6a21\u5f0f\uff09"
        },
        "function_graph_id": {
          "type": "string"
        },
        "parameter_bindings": {
          "type": "object",
          "description": "\u51fd\u6570\u56fe\u53c2\u6570\u7ed1\u5b9a"
        }
      }
    },
    "combine_config": {
      "type": "object",
      "description": "\u7ec4\u5408\u9a8c\u8bc1\u5668\u914d\u7f6e",
      "properties": {
        "logic_operator": {
          "type": "string",
          "enum": [
            "AND",
            "OR",
            "NOT",
            "XOR"
          ],
          "description": "\u903b\u8f91\u64cd\u4f5c\u7b26"
        },
        "sub_validator_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u5b50\u9a8c\u8bc1\u5668ID\u5217\u8868"
        }
      }
    },
    "function_graph_config": {
      "type": "object",
      "description": "\u51fd\u6570\u56fe\u914d\u7f6e",
      "properties": {
        "function_graph_id": {
          "type": "string"
        },
        "parameter_bindings": {
          "type": "object",
          "description": "\u53c2\u6570\u7ed1\u5b9a\u6620\u5c04"
        }
      }
    },
    "negate": {
      "type": "boolean",
      "default": false,
      "description": "\u662f\u5426\u53d6\u53cd\u7ed3\u679c"
    },
    "failure_result": {
      "type": "string",
      "enum": [
        "false",
        "unknown"
      ],
      "default": "false",
      "description": "\u5931\u8d25\u65f6\u8fd4\u56de\u7684\u7ed3\u679c"
    }
  },
  "required": [
    "validator_id",
    "name",
    "validator_type"
  ]
}