{
  "name": "AnimationClipAsset",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "type": "string",
      "description": "animation_clips.json id"
    },
    "asset_kind": {
      "type": "string",
      "enum": [
        "Clip",
        "BlendTree",
        "Montage",
        "PoseAsset"
      ],
      "description": "AnimationClipAssetKind"
    },
    "preview_mesh_asset_id": {
      "type": "string",
      "description": "Editor-only Asset.asset_id used to preview this animation binding; not exported."
    },
    "locators": {
      "type": "array",
      "description": "Animation host bindings persisted directly as runtime locators.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "backend_id": {
            "type": "string"
          },
          "asset_ref": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          }
        },
        "required": [
          "backend_id",
          "asset_ref"
        ]
      }
    },
    "blend_inputs": {
      "type": "object",
      "description": "AnimationBlendInputSource per axis",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "string",
          "enum": [
            "Zero",
            "Scalar0",
            "Scalar1",
            "NormalizedTime",
            "Weight01"
          ]
        },
        "y": {
          "type": "string",
          "enum": [
            "Zero",
            "Scalar0",
            "Scalar1",
            "NormalizedTime",
            "Weight01"
          ]
        }
      }
    }
  },
  "required": [
    "asset_id",
    "asset_kind",
    "locators"
  ]
}