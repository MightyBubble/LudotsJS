{
  "name": "EditorMeta",
  "type": "object",
  "properties": {
    "entity_name": {
      "type": "string",
      "description": "\u6240\u5c5e\u5b9e\u4f53\u540d\uff08\u5982 DataTable\u3001StructureDefinition\uff09"
    },
    "record_id": {
      "type": "string",
      "description": "\u5bf9\u5e94\u8bb0\u5f55\u7684 id"
    },
    "workspace_id": {
      "type": "string",
      "description": "\u4f5c\u7528\u57df\uff1a\u6240\u5c5e\u5de5\u4f5c\u533a"
    },
    "project_id": {
      "type": "string",
      "description": "\u4f5c\u7528\u57df\uff1a\u6240\u5c5e\u9879\u76ee\uff08workspace \u5171\u4eab\u65f6\u4e3a\u7a7a\uff09"
    },
    "folder_id": {
      "type": "string",
      "description": "\u6240\u5c5e ProjectFolder \u7684 folder_id"
    },
    "category_path": {
      "type": "string",
      "default": "",
      "description": "\u65e7\u7248\u865a\u62df\u76ee\u5f55\u8def\u5f84\uff0c\u7528 / \u5206\u9694\uff08\u517c\u5bb9\u4fdd\u7559\uff09"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false,
      "description": "\u662f\u5426\u6536\u85cf"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u540c\u76ee\u5f55\u5185\u6392\u5e8f"
    }
  },
  "required": [
    "entity_name",
    "record_id"
  ]
}