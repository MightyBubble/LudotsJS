{
  "name": "EntityPanelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "panel_id": {
      "type": "string",
      "description": "\u5b9e\u4f53\u9762\u677f Profile \u6807\u8bc6"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_key": {
          "type": "string",
          "description": "\u6d88\u8d39\u7684 EntityCollection.collection_key"
        }
      },
      "required": [
        "collection_key"
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_query_graph_ref": {
          "type": "string",
          "description": "\u5728\u6765\u6e90\u96c6\u5408\u5185\u6267\u884c\u7684 EntityQuery.query_name\uff1b\u7559\u7a7a\u8868\u793a\u4e0d\u8fc7\u6ee4"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "flat",
            "aggregate"
          ],
          "default": "flat"
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "default": 4
        },
        "visible_rows": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "mode",
        "columns"
      ]
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "single",
            "multiple"
          ],
          "default": "multiple"
        }
      },
      "required": [
        "mode"
      ]
    }
  },
  "required": [
    "panel_id",
    "source",
    "filter",
    "layout",
    "selection"
  ]
}