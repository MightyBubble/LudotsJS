          "type": "integer"
        },
        "collisionRelationFilter": {
          "type": "string"
        },
        "collisionExcludeSource": {
          "type": "boolean"
        },
        "maxHitCount": {
          "type": "integer"
        }
      }
    },
    "unitCreation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "placementPattern": {
          "type": "string"
        },
        "facingPattern": {
          "type": "string"
        },
        "unitType": {
          "type": "string"
        },
        "templateId": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "offsetRadius": {
          "type": "integer"
        },
        "placementRadiusCm": {
          "type": "integer"
        },
        "placementStartAngleDeg": {
          "type": "integer"
        },
        "onSpawnEffect": {
          "type": "string"
        },
        "copySourcePlayerOwner": {
          "type": "boolean"
        },
        "linkSourceAsParent": {
          "type": "boolean"
        }
      }
    },
    "displacement": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "directionMode": {
          "type": "string"
