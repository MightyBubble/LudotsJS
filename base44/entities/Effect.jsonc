          "type": "integer"
        }
      }
    },
    "submitOrderFromBlackboard": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "storedTarget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "targetKindKey": {
              "type": "string"
            },
            "targetPositionKey": {
              "type": "string"
            },
            "targetEntityKey": {
              "type": "string"
            },
            "hexQKey": {
              "type": "string"
            },
            "hexRKey": {
              "type": "string"
            }
          }
        },
        "pointMoveOrderTypeKey": {
          "type": "string"
        },
        "entityOrderTypeKey": {
          "type": "string"
        },
        "entityOrderIntArg0": {
          "type": "integer"
        },
