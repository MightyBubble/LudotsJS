{
  "name": "Effect",
  "type": "object",
  "properties": {
    "effect_id": {
      "type": "string",
      "description": "\u6548\u679c\u552f\u4e00ID"
    },
    "name": {
      "type": "string",
      "description": "\u663e\u793a\u540d\u79f0"
    },
    "description": {
      "type": "string",
      "description": "\u63cf\u8ff0"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u6548\u679c\u81ea\u8eab\u6807\u7b7e"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u662f\u5426\u542f\u7528"
    },
    "lifetime": {
      "type": "object",
      "description": "\u751f\u547d\u5468\u671f",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instant",
            "durable"
          ],
          "default": "instant"
        },
        "duration_policy": {
          "type": "string",
          "enum": [
            "finite",
            "infinite",
            "until_condition"
          ],
          "default": "finite"
        },
        "duration": {
          "type": "object",
          "description": "ValueSource"
        },
        "expiration_requirement_id": {
          "type": "string"
        },
        "period": {
          "type": "object",
          "description": "ValueSource"
        },
        "execute_on_apply": {
          "type": "boolean",
          "default": true
        },
        "execute_on_period": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "application": {
      "type": "object",
      "description": "\u5e94\u7528\u4e0e\u53e0\u52a0",
      "properties": {
        "stacking": {
          "type": "string",
          "enum": [
            "none",
            "aggregate_by_source",
            "aggregate_by_target",
            "independent"
          ],
          "default": "none"
        },
        "max_stacks": {
          "type": "number"
        },
        "overflow": {
          "type": "string",
          "enum": [
            "reject",
            "refresh_duration",
            "replace_oldest",
            "execute_overflow_effect"
          ],
          "default": "reject"
        },
        "overflow_effect_id": {
          "type": "string"
        },
        "duration_refresh": {
          "type": "string",
          "enum": [
            "never",
            "on_reapply",
            "on_stack_added"
          ],
          "default": "never"
        },
        "period_reset": {
          "type": "string",
          "enum": [
            "never",
            "on_reapply",
            "on_stack_added"
          ],
          "default": "never"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u5f15\u7528\u7684 Requirement ID \u5217\u8868"
    },
    "target": {
      "type": "object",
      "description": "TargetResolver"
    },
    "blackboard": {
      "type": "object",
      "description": "\u9ed1\u677f\u53d8\u91cf\u5b9a\u4e49"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Effect Operations"
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Effect Hooks"
    },
    "granted_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed_tags_on_apply": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "effect_id",
    "name"
  ]
}