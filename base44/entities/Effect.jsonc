    "stack": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "limit": {
          "type": "integer"
        },
        "policy": {
          "type": "string",
          "enum": [
            "KeepDuration",
            "RefreshDuration",
            "AddDuration"
