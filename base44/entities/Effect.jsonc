{
  "name": "Effect",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "effect_id": {
      "type": "string",
      "description": "C# EffectTemplateConfig.id\uff1b\u5e73\u53f0\u5185\u7f6e id \u5360\u7528\uff0c\u6545\u5b58\u4e3a effect_id"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 1
    },
    "presetType": {
      "type": "string",
      "enum": [
        "None",
        "ApplyForce2D",
        "InstantDamage",
        "DoT",
        "Heal",
        "HoT",
        "Buff",
        "Search",
        "PeriodicSearch",
        "LaunchProjectile",
        "CreateUnit",
        "Displacement",
        "Relation",
        "Exchange",
        "CompleteProgression",
        "SubmitOrderFromBlackboard",
        "DeployConsumeSource",
        "RevealArea"
      ]
    },
    "lifetime": {
      "type": "string",
      "enum": [
        "Instant",
        "After",
        "Infinite"
      ]
    },
    "participatesInResponse": {
      "type": "boolean"
    },
    "expireCondition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "TagPresent",
            "TagAbsent"
          ]
        },
        "tag": {
          "type": "string"
        },
        "sense": {
          "type": "string",
          "enum": [
            "Raw",
            "Effective"
          ]
        }
      }
    },
    "duration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "durationTicks": {
          "type": "integer"
        },
        "periodTicks": {
          "type": "integer"
        },
        "clockId": {
          "type": "string"
        }
      }
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attribute": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "enum": [
              "Add",
              "Multiply",
              "Override"
            ]
          },
          "value": {
            "type": "number"
          }
        }
      }
    },
    "targetQuery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "radius": {
          "type": "integer"
        },
        "innerRadius": {
          "type": "integer"
        },
        "halfAngle": {
          "type": "integer"
        },
        "halfWidth": {
          "type": "integer"
        },
        "halfHeight": {
          "type": "integer"
        },
        "rotation": {
          "type": "integer"
        },
        "length": {
          "type": "integer"
        },
        "origin": {
          "type": "string"
        },
        "graphProgramId": {
          "type": "integer"
        }
      }
    },
    "targetFilter": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "relationFilter": {
          "type": "string"
        },
        "excludeSource": {
          "type": "boolean"
        },
        "maxTargets": {
          "type": "integer"
        },
        "layerMask": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "targetDispatch": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string"
        },
        "payloadEffect": {
          "type": "string"
        },
        "contextMapping": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "payloadSource": {
              "type": "string"
            },
            "payloadTarget": {
              "type": "string"
            },
            "payloadTargetContext": {
              "type": "string"
            }
          }
        }
      }
    },
    "projectile": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
