{
  "name": "Effect",
  "type": "object",
  "properties": {
    "effect_id": {
      "type": "string",
      "description": "\u5bf9\u5e94 C# EffectTemplateConfig.id\uff1b\u56e0\u5e73\u53f0\u5185\u7f6e id \u5b57\u6bb5\u5360\u7528\u800c\u4f7f\u7528\u6b64\u5b58\u50a8\u540d"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "presetType": {
      "type": "string"
    },
    "lifetime": {
      "type": "string",
      "enum": [
        "Instant",
        "After",
        "Infinite"
      ],
      "default": "Instant"
    },
    "participatesInResponse": {
      "type": "boolean"
    },
    "expireCondition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "TagPresent",
            "TagAbsent"
          ]
        },
        "tag": {
          "type": "string"
        },
        "sense": {
          "type": "string",
          "enum": [
            "Raw",
            "Effective"
          ]
        }
      }
    },
    "duration": {
      "type": "object",
      "properties": {
        "durationTicks": {
          "type": "integer"
        },
        "periodTicks": {
          "type": "integer"
        },
        "clockId": {
          "type": "string"
        }
      }
    },
    "application": {
      "type": "object",
      "properties": {
        "stacking": {
          "type": "string",
          "enum": [
            "none",
            "aggregate_by_source",
            "aggregate_by_target",
            "independent"
          ],
          "default": "none"
        },
        "max_stacks": {
          "type": "number"
        },
        "overflow": {
          "type": "string",
          "enum": [
            "reject",
            "refresh_duration",
            "replace_oldest",
            "execute_overflow_effect"
          ],
          "default": "reject"
        },
        "overflow_effect_id": {
          "type": "string"
        },
        "duration_refresh": {
          "type": "string",
          "enum": [
            "never",
            "on_reapply",
            "on_stack_added"
          ],
          "default": "never"
        },
        "period_reset": {
          "type": "string",
          "enum": [
            "never",
            "on_reapply",
            "on_stack_added"
          ],
          "default": "never"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target": {
      "type": "object"
    },
    "blackboard": {
      "type": "object"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase_id": {
            "type": "string",
            "enum": [
              "on_propose",
              "on_calculate",
              "on_resolve",
              "on_hit",
              "on_apply",
              "on_period",
              "on_expire",
              "on_remove"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "pre_action_graph_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "main": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "none",
                  "builtin",
                  "action_graph"
                ],
                "default": "none"
              },
              "builtin": {
                "type": "object"
              },
              "action_graph_id": {
                "type": "string"
              },
              "parameter_mappings_text": {
                "type": "string"
              }
            }
          },
          "post_action_graph_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "listeners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "listener_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "target",
                    "source",
                    "global"
                  ],
                  "default": "target"
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "priority": {
                  "type": "number",
                  "default": 0
                },
                "max_executions": {
                  "type": "number"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "responses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "response_type": {
                        "type": "string",
                        "enum": [
                          "apply_effect",
                          "remove_effect",
                          "emit_event",
                          "activate_ability",
                          "entity_lifecycle_request"
                        ]
                      },
                      "effect_id": {
                        "type": "string"
                      },
                      "event_id": {
                        "type": "string"
                      },
                      "ability_id": {
                        "type": "string"
                      },
                      "lifecycle_request": {
                        "type": "string",
                        "enum": [
                          "create",
                          "destroy"
                        ]
                      },
                      "prototype_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "response_chain": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "max_depth": {
          "type": "number",
          "default": 3
        },
        "max_responses": {
          "type": "number",
          "default": 8
        },
        "root_budget": {
          "type": "number",
          "default": 16
        },
        "dedupe_by_correlation": {
          "type": "boolean",
          "default": true
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "reject",
                  "cancel",
                  "modify",
                  "redirect",
                  "replace",
                  "append"
                ]
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "priority": {
                "type": "number",
                "default": 0
              },
              "modify_mapping_text": {
                "type": "string"
              },
              "redirect_query_id": {
                "type": "string"
              },
              "replacement_effect_id": {
                "type": "string"
              },
              "appended_effect_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "granted_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed_tags_on_apply": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "effect_id",
    "lifetime",
    "participatesInResponse"
  ]
}