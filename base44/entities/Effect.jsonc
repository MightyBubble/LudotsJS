{
  "name": "Effect",
  "type": "object",
  "properties": {
    "effect_id": {
      "type": "string",
      "description": "\u6548\u679c\u552f\u4e00ID"
    },
    "name": {
      "type": "string",
      "description": "\u663e\u793a\u540d\u79f0"
    },
    "description": {
      "type": "string",
      "description": "\u63cf\u8ff0"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u6548\u679c\u81ea\u8eab\u6807\u7b7e"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u662f\u5426\u542f\u7528"
    },
    "lifetime": {
      "type": "object",
      "description": "\u751f\u547d\u5468\u671f\uff08\u5bf9\u9f50 EffectLifetimeKind\uff1ainstant / after / infinite\uff09",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instant",
            "after",
            "infinite"
          ],
          "default": "instant",
          "description": "instant \u77ac\u65f6\uff1bafter \u5b9a\u65f6\uff08Durable\uff0c\u9700 duration\uff09\uff1binfinite \u65e0\u9650\uff08Durable\uff09"
        },
        "duration": {
          "type": "object",
          "description": "ValueSource\uff0c\u4ec5 after \u4f7f\u7528"
        },
        "period": {
          "type": "object",
          "description": "ValueSource\uff0cafter / infinite \u53ef\u7528"
        },
        "expiration_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u6761\u4ef6/Tag \u9a71\u52a8\u7684\u79fb\u9664\u5224\u5b9a\uff08\u4e0e LifetimeKind \u6b63\u4ea4\uff0c\u7531 Requirement \u6216 Trigger \u53d1\u8d77 remove\uff09"
        }
      }
    },
    "application": {
      "type": "object",
      "description": "\u5e94\u7528\u4e0e\u53e0\u52a0",
      "properties": {
        "stacking": {
          "type": "string",
          "enum": [
            "none",
            "aggregate_by_source",
            "aggregate_by_target",
            "independent"
          ],
          "default": "none"
        },
        "max_stacks": {
          "type": "number"
        },
        "overflow": {
          "type": "string",
          "enum": [
            "reject",
            "refresh_duration",
            "replace_oldest",
            "execute_overflow_effect"
          ],
          "default": "reject"
        },
        "overflow_effect_id": {
          "type": "string"
        },
        "duration_refresh": {
          "type": "string",
          "enum": [
            "never",
            "on_reapply",
            "on_stack_added"
          ],
          "default": "never"
        },
        "period_reset": {
          "type": "string",
          "enum": [
            "never",
            "on_reapply",
            "on_stack_added"
          ],
          "default": "never"
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u5f15\u7528\u7684 Requirement ID \u5217\u8868"
    },
    "target": {
      "type": "object",
      "description": "TargetResolver"
    },
    "blackboard": {
      "type": "object",
      "description": "\u9ed1\u677f\u53d8\u91cf\u5b9a\u4e49"
    },
    "phases": {
      "type": "array",
      "description": "\u6b63\u5f0f\u7ed3\u6784\uff1aPhase Bindings\uff0c\u56fa\u5b9a\u987a\u5e8f on_propose \u2192 on_calculate \u2192 on_resolve \u2192 on_hit \u2192 on_apply \u2192 on_period \u2192 on_expire \u2192 on_remove",
      "items": {
        "type": "object",
        "properties": {
          "phase_id": {
            "type": "string",
            "enum": [
              "on_propose",
              "on_calculate",
              "on_resolve",
              "on_hit",
              "on_apply",
              "on_period",
              "on_expire",
              "on_remove"
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "pre_action_graph_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Pre \u9636\u6bb5\u5f15\u7528\u7684 ActionGraph.action_id"
          },
          "main": {
            "type": "object",
            "description": "Main Operation",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "none",
                  "builtin",
                  "action_graph"
                ],
                "default": "none"
              },
              "builtin": {
                "type": "object",
                "description": "\u5185\u7f6e\u64cd\u4f5c\u53c2\u6570"
              },
              "action_graph_id": {
                "type": "string"
              },
              "parameter_mappings_text": {
                "type": "string"
              }
            }
          },
          "post_action_graph_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Post \u9636\u6bb5\u5f15\u7528\u7684 ActionGraph.action_id"
          },
          "listeners": {
            "type": "array",
            "description": "Phase Listeners\uff08\u539f Hook\uff09\uff1aPre/Main/Post \u5b8c\u6210\u540e\u5206\u53d1\uff0c\u4ec5\u5141\u8bb8\u5165\u961f Request",
            "items": {
              "type": "object",
              "properties": {
                "listener_id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "target",
                    "source",
                    "global"
                  ],
                  "default": "target"
                },
                "requirements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "priority": {
                  "type": "number",
                  "default": 0
                },
                "max_executions": {
                  "type": "number"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "responses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "response_type": {
                        "type": "string",
                        "enum": [
                          "apply_effect",
                          "remove_effect",
                          "emit_event",
                          "activate_ability",
                          "entity_lifecycle_request"
                        ]
                      },
                      "effect_id": {
                        "type": "string"
                      },
                      "event_id": {
                        "type": "string"
                      },
                      "ability_id": {
                        "type": "string"
                      },
                      "lifecycle_request": {
                        "type": "string",
                        "enum": [
                          "create",
                          "destroy"
                        ]
                      },
                      "prototype_id": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "response_chain": {
      "type": "object",
      "description": "OnPropose \u4e0e OnCalculate \u4e4b\u95f4\u7684\u54cd\u5e94\u7a97\u53e3\uff08\u4e0d\u662f phase\uff09",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "max_depth": {
          "type": "number",
          "default": 3
        },
        "max_responses": {
          "type": "number",
          "default": 8
        },
        "root_budget": {
          "type": "number",
          "default": 16
        },
        "dedupe_by_correlation": {
          "type": "boolean",
          "default": true
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entry_id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "action": {
                "type": "string",
                "enum": [
                  "reject",
                  "cancel",
                  "modify",
                  "redirect",
                  "replace",
                  "append"
                ]
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "priority": {
                "type": "number",
                "default": 0
              },
              "modify_mapping_text": {
                "type": "string"
              },
              "redirect_query_id": {
                "type": "string"
              },
              "replacement_effect_id": {
                "type": "string"
              },
              "appended_effect_id": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "[\u65e7\u7248\u517c\u5bb9] \u5e73\u94fa Operations\uff0c\u65b0\u8bb0\u5f55\u8bf7\u4f7f\u7528 phases"
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "[\u65e7\u7248\u517c\u5bb9] \u65e7 Hook \u5217\u8868\uff0c\u65b0\u8bb0\u5f55\u8bf7\u4f7f\u7528 phases[].listeners"
    },
    "granted_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "removed_tags_on_apply": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "effect_id",
    "name"
  ]
}