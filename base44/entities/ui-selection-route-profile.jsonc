{
  "name": "UISelectionRouteProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "route_id": {
      "type": "string",
      "description": "\u9009\u4e2d\u8def\u7531 Profile \u7684\u7a33\u5b9a\u6807\u8bc6"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_key": {
          "type": "string",
          "description": "\u9009\u4e2d\u4e0a\u4e0b\u6587\u96c6\u5408\u952e\uff08EntityCollection.collection_key\uff09\uff0c\u901a\u5e38\u4e3a Global.Selection"
        }
      },
      "required": [
        "collection_key"
      ]
    },
    "rules": {
      "type": "array",
      "description": "\u6309\u987a\u5e8f\u9996\u6761\u547d\u4e2d\u5373\u751f\u6548\uff1b\u65e0\u89c4\u5219\u547d\u4e2d\u65f6\u6240\u6709\u69fd\u4f4d\u663e\u5f0f\u7559\u7a7a\uff0c\u4e0d\u505a\u515c\u5e95",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "selection": {
                "type": "string",
                "enum": [
                  "none",
                  "single",
                  "multiple",
                  "any"
                ],
                "default": "any",
                "description": "\u9009\u4e2d\u6570\u91cf\u8bed\u4e49\uff1a\u65e0\u9009\u4e2d / \u5355\u9009 / \u591a\u9009(\u22652) / \u4efb\u610f"
              },
              "required_all_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u6bcf\u4e2a\u9009\u4e2d\u5b9e\u4f53\u90fd\u987b\u5e26\u5168\u90e8\u8fd9\u4e9b\u6807\u7b7e"
              },
              "blocked_any_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u4efb\u4e00\u9009\u4e2d\u5b9e\u4f53\u5e26\u4efb\u4e00\u6807\u7b7e\u5373\u4e0d\u547d\u4e2d"
              },
              "prototype_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u6bcf\u4e2a\u9009\u4e2d\u5b9e\u4f53\u7684 Prototype \u90fd\u987b\u5728\u6b64\u5217\u8868\u5185\uff1b\u7559\u7a7a\u4e0d\u9650\u5236"
              }
            },
            "required": [
              "selection"
            ]
          },
          "panels": {
            "type": "array",
            "description": "\u547d\u4e2d\u540e\u5404\u69fd\u4f4d\u6302\u8f7d\u7684\u9762\u677f\uff1bslot_id \u5bf9\u5e94 UIScreenProfile.slots",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slot_id": {
                  "type": "string"
                },
                "panel_kind": {
                  "type": "string",
                  "enum": [
                    "command",
                    "entity",
                    "selection_info"
                  ],
                  "description": "\u9762\u677f\u79cd\u7c7b\u6ce8\u518c\u8868 UI_PANEL_KINDS \u7684\u952e"
                },
                "profile_ref": {
                  "type": "string",
                  "description": "command\u2192CommandPanelProfile.panel_id\uff1bentity\u2192EntityPanelProfile.panel_id\uff1bselection_info\u2192UIItemPresentationProfile.profile_id(item_kind=entity)"
                }
              },
              "required": [
                "slot_id",
                "panel_kind",
                "profile_ref"
              ]
            }
          }
        },
        "required": [
          "rule_id",
          "match",
          "panels"
        ]
      }
    }
  },
  "required": [
    "route_id",
    "source",
    "rules"
  ]
}