{
  "name": "CommandPanelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "panel_id": {
      "type": "string",
      "description": "\u9762\u677f\u552f\u4e00\u6807\u8bc6\u3002\u4e00\u6761\u8bb0\u5f55\u5c31\u662f\u4e00\u4e2a\u9762\u677f"
    },
    "label": {
      "type": "string",
      "description": "\u663e\u793a\u540d"
    },
    "description": {
      "type": "string",
      "description": "\u8bf4\u660e"
    },
    "layout_mode": {
      "type": "string",
      "enum": [
        "fixed",
        "dynamic"
      ],
      "default": "dynamic",
      "description": "\u843d\u4f4d\u65b9\u5f0f\uff1afixed = \u6309\u8bed\u4e49\u69fd\u4f4d\u56fa\u5b9a\u6446\u653e\uff08\u672a\u547d\u4e2d\u7684\u69fd\u4f4d\u7559\u7a7a\u5360\u4f4d\uff0c\u4e0d\u584c\u7f29\uff09\uff1bdynamic = \u6309\u6392\u5e8f\u89c4\u5219\u52a8\u6001\u6392\u5217\u5e76\u987a\u5e8f\u53d6\u5feb\u6377\u952e"
    },
    "actor_collection_key": {
      "type": "string",
      "description": "\u9762\u677f\u770b\u54ea\u4e2a Actor \u96c6\u5408\uff08ControlPlane \u67e5\u8be2\u56fe\u8f93\u51fa\uff1b\u96c6\u5408\u7684\u6392\u5e8f\u4e0e\u88c1\u526a\u7531\u67e5\u8be2\u56fe\u8d1f\u8d23\uff0c\u9762\u677f\u53ea\u6d88\u8d39\u7ed3\u679c\uff09"
    },
    "required_all_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u8fc7\u6ee4\uff1a\u6280\u80fd catalogTags \u5fc5\u987b\u5168\u90e8\u547d\u4e2d\u624d\u8fdb\u5165\u672c\u9762\u677f"
    },
    "blocked_any_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u8fc7\u6ee4\uff1a\u6280\u80fd catalogTags \u547d\u4e2d\u4efb\u4e00\u5373\u6392\u9664"
    },
    "aggregate": {
      "type": "boolean",
      "default": true,
      "description": "\u805a\u5408\uff1a\u591a\u4e2a Actor \u7684\u6280\u80fd\u662f\u5426\u5408\u5e76\u6210\u4e00\u4e2a\u6309\u94ae\u3002false = \u6bcf\u4e2a Actor \u7684\u6280\u80fd\u5404\u81ea\u6210\u72ec\u7acb\u6309\u94ae"
    },
    "aggregate_key_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u805a\u5408\u8eab\u4efd\u7ef4\u5ea6\uff1a\u53d6\u6280\u80fd catalogTags \u4e2d\u843d\u5728\u8fd9\u4e9b\u7ef4\u5ea6\u4e0b\u7684\u90e8\u5206\u4f5c\u4e3a\u805a\u5408 key\uff0ckey \u76f8\u540c\u5373\u540c\u4e00\u6309\u94ae\uff08\u4f7f\u4e0d\u540c ability_id \u7684\u540c\u4e49\u547d\u4ee4\u53ef\u5408\u5e76\uff09\u3002\u7559\u7a7a\u5219\u6309 ability_id \u5224\u7b49"
    },
    "columns": {
      "type": [
        "integer",
        "null"
      ],
      "description": "\u6bcf\u884c\u6309\u94ae\u6570"
    },
    "visible_rows": {
      "type": [
        "integer",
        "null"
      ],
      "description": "\u53ef\u89c6\u884c\u6570\uff08\u89c6\u53e3\u9ad8\u5ea6\uff09\uff1b\u6309\u94ae\u8d85\u51fa\u540e\u9762\u677f\u5185\u6eda\u52a8"
    },
    "slots": {
      "type": "array",
      "description": "layout_mode = fixed \u65f6\u751f\u6548\u3002\u8bed\u4e49\u69fd\u4f4d\u8868\uff1b\u547d\u4e2d\u6761\u4ef6\u7559\u7a7a\u7684\u69fd\u4f4d\u59cb\u7ec8\u4e3a\u7a7a\u5360\u4f4d",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot_id": {
            "type": "string",
            "description": "\u8bed\u4e49\u5316\u69fd\u4f4d\u6807\u8bc6\uff08\u5f15\u7528\u5168\u5c40\u5e38\u91cf\uff0c\u5982 Slot.Primary / Slot.Build.First\uff09"
          },
          "action_id": {
            "type": "string",
            "description": "\u7ed1\u5b9a\u7684 InputConfig action id"
          },
          "required_all_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u5360\u7528\u8be5\u69fd\u4f4d\u7684\u6280\u80fd\u987b\u5168\u90e8\u547d\u4e2d\u7684\u6807\u7b7e"
          },
          "blocked_any_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u547d\u4e2d\u4efb\u4e00\u5219\u4e0d\u5360\u7528\u8be5\u69fd\u4f4d"
          }
        },
        "required": [
          "slot_id"
        ]
      }
    },
    "sort_key": {
      "type": "string",
      "description": "layout_mode = dynamic \u65f6\u751f\u6548\u3002\u6309\u94ae\u6392\u5217\u7684\u6392\u5e8f\u89c4\u5219\u952e\uff08\u5f15\u7528\u5168\u5c40\u5e38\u91cf\uff09"
    },
    "hotkey_sequence_ref": {
      "type": "string",
      "description": "layout_mode = dynamic \u65f6\u751f\u6548\u3002\u6709\u5e8f action \u5e8f\u5217\u7684\u5f15\u7528\uff08\u5f15\u7528\u5168\u5c40\u5e38\u91cf\uff0c\u5982 Q W E R\uff09\uff1b\u6309\u94ae\u6309\u843d\u4f4d\u987a\u5e8f\u4f9d\u6b21\u53d6\u952e"
    }
  },
  "required": [
    "panel_id",
    "layout_mode"
  ]
}