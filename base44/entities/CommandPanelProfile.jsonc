{
  "name": "CommandPanelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "panel_id": {
      "type": "string",
      "description": "\u9762\u677f\u552f\u4e00\u6807\u8bc6"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "item_presentation_profile_ref": {
      "type": "string",
      "description": "UIItemPresentationProfile.profile_id\uff08item_kind=ability\uff09"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_key": {
          "type": "string"
        }
      },
      "required": [
        "collection_key"
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_all_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked_any_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match_all_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "aggregate_key_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "match_all_tags"
            ]
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fixed",
            "dynamic"
          ],
          "default": "dynamic"
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": [
                "integer",
                "null"
              ]
            },
            "visible_rows": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "fixed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "slot_id": {
                    "type": "string"
                  },
                  "role_id": {
                    "type": "string"
                  },
                  "action_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "slot_id",
                  "role_id"
                ]
              }
            }
          }
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buckets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "required_all_tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blocked_any_tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "hotkey_action_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "mode",
        "grid",
        "fixed",
        "dynamic"
      ]
    }
  },
  "required": [
    "panel_id",
    "source",
    "filter",
    "grouping",
    "layout"
  ]
}