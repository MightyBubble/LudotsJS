{
  "name": "CommandPanelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "panel_id": {
      "type": "string",
      "description": "\u9762\u677f\u552f\u4e00\u6807\u8bc6\uff1b\u4e00\u6761\u8bb0\u5f55\u5c31\u662f\u4e00\u4e2a\u9762\u677f"
    },
    "label": {
      "type": "string",
      "description": "\u663e\u793a\u540d"
    },
    "description": {
      "type": "string",
      "description": "\u8bf4\u660e"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_key": {
          "type": "string",
          "description": "\u8bfb\u53d6\u7684 EntityCollection.collection_key"
        }
      },
      "required": [
        "collection_key"
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_all_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u52a8\u6001\u5019\u9009\u6280\u80fd\u987b\u5168\u90e8\u547d\u4e2d\u7684\u9886\u57df\u6807\u7b7e"
        },
        "blocked_any_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u52a8\u6001\u5019\u9009\u6280\u80fd\u547d\u4e2d\u4efb\u4e00\u5373\u6392\u9664\u7684\u9886\u57df\u6807\u7b7e"
        }
      }
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "description": "\u591a\u4e2a Actor \u7684\u6280\u80fd\u6309\u94ae\u805a\u5408\u89c4\u5219\uff1b\u5148\u547d\u4e2d\u5148\u751f\u6548",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match_all_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u7559\u7a7a\u5219\u547d\u4e2d\u5168\u90e8\u6280\u80fd"
              },
              "aggregate_key_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u6309\u9886\u57df\u6807\u7b7e\u524d\u7f00\u63d0\u53d6\u805a\u5408\u952e\uff1b\u7559\u7a7a\u6309 ability_id \u5224\u7b49"
              }
            },
            "required": [
              "match_all_tags"
            ]
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fixed",
            "dynamic"
          ],
          "default": "dynamic"
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": [
                "integer",
                "null"
              ],
              "description": "\u6bcf\u884c\u6309\u94ae\u6570"
            },
            "visible_rows": {
              "type": [
                "integer",
                "null"
              ],
              "description": "\u53ef\u89c6\u884c\u6570\uff0c\u8d85\u51fa\u540e\u9762\u677f\u5185\u6eda\u52a8"
            }
          }
        },
        "fixed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slots": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "slot_id": {
                    "type": "string",
                    "description": "\u9762\u677f\u5185\u552f\u4e00\u7684\u7269\u7406\u69fd\u4f4d\u6807\u8bc6"
                  },
                  "role_id": {
                    "type": "string",
                    "description": "\u901a\u8fc7 EntityPrototype.role_bindings \u89e3\u6790 Ability \u7684\u9886\u57df\u8bed\u4e49"
                  },
                  "action_id": {
                    "type": "string",
                    "description": "\u7ed1\u5b9a\u7684 InputConfig action id"
                  }
                },
                "required": [
                  "slot_id",
                  "role_id"
                ]
              }
            }
          }
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buckets": {
              "type": "array",
              "description": "\u6709\u5e8f\u6392\u5e8f\u6876\uff1b\u6309\u94ae\u8fdb\u5165\u9996\u4e2a\u547d\u4e2d\u7684\u6876\uff0c\u672a\u547d\u4e2d\u7684\u6392\u5728\u672b\u5c3e",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "required_all_tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blocked_any_tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "hotkey_action_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "\u6309\u6700\u7ec8\u843d\u4f4d\u987a\u5e8f\u4f9d\u6b21\u5206\u914d\u7684 Input Action"
            }
          }
        }
      },
      "required": [
        "mode",
        "grid",
        "fixed",
        "dynamic"
      ]
    }
  },
  "required": [
    "panel_id",
    "source",
    "filter",
    "grouping",
    "layout"
  ]
}