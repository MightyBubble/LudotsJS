{
  "name": "CommandPanelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "panel_id": {
      "type": "string",
      "description": "\u9762\u677f\u552f\u4e00\u6807\u8bc6\u3002\u4e00\u6761\u8bb0\u5f55\u5c31\u662f\u4e00\u4e2a\u9762\u677f"
    },
    "label": {
      "type": "string",
      "description": "\u663e\u793a\u540d"
    },
    "description": {
      "type": "string",
      "description": "\u8bf4\u660e"
    },
    "actor_collection_key": {
      "type": "string",
      "description": "\u9762\u677f\u770b\u54ea\u4e2a Actor \u96c6\u5408\uff08ControlPlane \u67e5\u8be2\u56fe\u8f93\u51fa\uff09"
    },
    "actor_sort": {
      "type": "string",
      "description": "\u53c2\u4e0e\u805a\u5408\u524d\u5bf9 Actor \u7684\u6392\u5e8f\u89c4\u5219\u952e"
    },
    "max_actors": {
      "type": [
        "integer",
        "null"
      ],
      "description": "\u53c2\u4e0e\u7684 Actor \u4e0a\u9650\uff1b1 \u5373\u53ea\u770b\u6392\u5e8f\u540e\u7684\u7b2c\u4e00\u4e2a\u5355\u4f4d\uff0c\u7559\u7a7a\u4e3a\u5168\u4f53"
    },
    "required_all_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u9762\u677f\u6536\u54ea\u4e9b\u6280\u80fd\uff1acatalogTags \u5fc5\u987b\u5168\u90e8\u547d\u4e2d"
    },
    "blocked_any_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u9762\u677f\u6392\u9664\u54ea\u4e9b\u6280\u80fd\uff1acatalogTags \u547d\u4e2d\u4efb\u4e00\u5373\u6392\u9664"
    },
    "aggregate": {
      "type": "boolean",
      "default": true,
      "description": "true = \u96c6\u5408\u5185\u591a\u4e2a\u5b9e\u4f53\u62e5\u6709\u540c\u4e00\u6280\u80fd\u65f6\u805a\u5408\u6210\u4e00\u4e2a\u6309\u94ae\uff1bfalse = \u6bcf\u4e2a\u5b9e\u4f53\u7684\u6280\u80fd\u5404\u81ea\u5e73\u94fa\u6210\u72ec\u7acb\u6309\u94ae"
    },
    "columns": {
      "type": [
        "integer",
        "null"
      ],
      "description": "\u6bcf\u884c\u6309\u94ae\u6570"
    },
    "rows": {
      "type": [
        "integer",
        "null"
      ],
      "description": "\u884c\u6570\uff1b\u7559\u7a7a\u8868\u793a\u6309\u94ae\u8d85\u8fc7\u4e00\u884c\u540e\u81ea\u52a8\u6362\u884c\u3001\u4e0d\u9650\u884c\u6570"
    },
    "slots": {
      "type": "array",
      "description": "\u56fa\u5b9a\u69fd\u4f4d\u3002\u914d\u4e86\u5c31\u6309\u69fd\u4f4d\u6446\uff1a\u6bcf\u4e2a\u69fd\u4f4d\u7528\u81ea\u5df1\u7684\u8fc7\u6ee4\u6761\u4ef6\u9501\u5b9a\u653e\u54ea\u4e2a\u6280\u80fd\uff0c\u5e76\u7ed1\u5b9a\u4e00\u4e2a input action\u3002\u6574\u4e2a\u5217\u8868\u7559\u7a7a\u5219\u4e0d\u56fa\u5b9a\uff0c\u5168\u90e8\u6309\u515c\u5e95\u6392\u5e8f\u52a8\u6001\u6392\u5217",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot_id": {
            "type": "string",
            "description": "\u69fd\u4f4d\u6807\u8bc6\uff08\u5982 Q / W / E / R\uff09"
          },
          "action_id": {
            "type": "string",
            "description": "\u7ed1\u5b9a\u7684 InputConfig action id"
          },
          "required_all_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u5360\u7528\u8be5\u69fd\u4f4d\u7684\u6280\u80fd\u987b\u5168\u90e8\u547d\u4e2d\u7684\u6807\u7b7e\uff1b\u7559\u7a7a\u5219\u8be5\u69fd\u4f4d\u4ea4\u7ed9\u52a8\u6001\u586b\u5145"
          },
          "blocked_any_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u547d\u4e2d\u4efb\u4e00\u5219\u4e0d\u5360\u7528\u8be5\u69fd\u4f4d"
          }
        },
        "required": [
          "slot_id"
        ]
      }
    },
    "fallback_sort": {
      "type": "string",
      "description": "\u52a8\u6001\u6392\u5217\u7684\u6392\u5e8f\u89c4\u5219\u952e\uff1a\u672a\u88ab\u56fa\u5b9a\u69fd\u4f4d\u9501\u5b9a\u7684\u6280\u80fd\u6309\u6b64\u987a\u5e8f\u586b\u5165\u5269\u4f59\u4f4d\u7f6e"
    }
  },
  "required": [
    "panel_id"
  ]
}