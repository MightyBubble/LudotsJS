{
  "name": "CommandPanelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "panel_id": {
      "type": "string",
      "description": "\u9762\u677f\u552f\u4e00\u6807\u8bc6\uff1b\u4e00\u6761\u8bb0\u5f55\u5c31\u662f\u4e00\u4e2a\u9762\u677f"
    },
    "label": {
      "type": "string",
      "description": "\u663e\u793a\u540d"
    },
    "description": {
      "type": "string",
      "description": "\u8bf4\u660e"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection_key": {
          "type": "string",
          "description": "\u8bfb\u53d6\u7684 EntityCollection.collection_key"
        }
      },
      "required": [
        "collection_key"
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_all_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u6280\u80fd\u987b\u5168\u90e8\u547d\u4e2d\u7684\u9886\u57df catalogTags"
        },
        "blocked_any_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u6280\u80fd\u547d\u4e2d\u4efb\u4e00\u5373\u6392\u9664\u7684\u9886\u57df catalogTags"
        }
      }
    },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "description": "\u591a\u4e2a Actor \u7684\u6280\u80fd\u6309\u94ae\u805a\u5408\u89c4\u5219\uff1b\u5148\u547d\u4e2d\u5148\u751f\u6548",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "match_all_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u7559\u7a7a\u5219\u547d\u4e2d\u5168\u90e8\u6280\u80fd"
              },
              "aggregate_key_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "\u7559\u7a7a\u5219\u6309 ability_id \u5224\u7b49"
              }
            },
            "required": [
              "match_all_tags"
            ]
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "fixed",
            "dynamic"
          ],
          "default": "dynamic"
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "columns": {
              "type": [
                "integer",
                "null"
              ],
              "description": "\u6bcf\u884c\u6309\u94ae\u6570"
            },
            "visible_rows": {
              "type": [
                "integer",
                "null"
              ],
              "description": "\u53ef\u89c6\u884c\u6570\uff0c\u8d85\u51fa\u540e\u9762\u677f\u5185\u6eda\u52a8"
            }
          }
        },
        "fixed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "slots": {
              "type": "array",
              "description": "\u56fa\u5b9a\u5c55\u793a\u69fd\u4f4d\uff1b\u4e24\u79cd\u53d6\u503c\u6765\u6e90\u4e8c\u9009\u4e00\uff1a\u8bed\u4e49\u89d2\u8272\uff08\u8bbe\u8ba1\u5e08\u610f\u56fe\uff0c\u73a9\u5bb6\u4e0d\u53ef\u6539\uff09\u6216\u5bb9\u5668\u69fd\u4f4d\u7d22\u5f15\uff08\u73a9\u5bb6\u53ef\u6362\u4f4d\uff0c\u8bfb\u5b9e\u4f53 container_slots\uff09",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "slot_id": {
                    "type": "string",
                    "description": "\u9762\u677f\u5185\u552f\u4e00\u7684\u5c55\u793a\u69fd\u4f4d\u6807\u8bc6"
                  },
                  "role_id": {
                    "type": "string",
                    "description": "AbilitySemanticProfile.roles.role_id\uff1b\u7531 EntityPrototype.role_bindings \u89e3\u6790\u5230 ability_id"
                  },
                  "container_slot_index": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "\u73a9\u5bb6\u53ef\u6362\u4f4d\u5bb9\u5668\u7684\u69fd\u4f4d\u7d22\u5f15\uff1b\u8bbe\u7f6e\u540e\u5ffd\u7565 role_id\uff0c\u4ece EntityPrototype.container_slots \u89e3\u6790\u3002\u5feb\u6377\u952e\u7ed1\u683c\u5b50\u4e0d\u7ed1\u6280\u80fd\uff0c\u73a9\u5bb6\u6362\u4f4d\u540e\u5feb\u6377\u952e\u8ddf\u7740\u683c\u5b50\u8d70"
                  },
                  "action_id": {
                    "type": "string",
                    "description": "\u7ed1\u5b9a\u7684 InputConfig action id"
                  }
                },
                "required": [
                  "slot_id"
                ]
              }
            }
          }
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "buckets": {
              "type": "array",
              "description": "\u6709\u5e8f\u6392\u5217\u6876\uff1b\u6309\u94ae\u8fdb\u5165\u9996\u4e2a\u547d\u4e2d\u7684\u6876\uff0c\u672a\u547d\u4e2d\u7684\u6392\u5728\u672b\u5c3e\uff0c\u540c\u6876\u6309 ability_id \u7a33\u5b9a\u6392\u5e8f\u3002\u4ec5\u7528\u4e8e\u8bbe\u8ba1\u5e08\u51b3\u5b9a\u987a\u5e8f\u7684\u5bb9\u5668\uff0c\u73a9\u5bb6\u53ef\u6362\u4f4d\u5bb9\u5668\u8bf7\u6539\u7528 fixed + container_slot_index",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "required_all_tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "blocked_any_tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "hotkey_action_ids": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "\u6309\u6700\u7ec8\u843d\u4f4d\u987a\u5e8f\u4f9d\u6b21\u5206\u914d\u7684 Input Action"
            }
          }
        }
      },
      "required": [
        "mode",
        "grid",
        "fixed",
        "dynamic"
      ]
    }
  },
  "required": [
    "panel_id",
    "source",
    "filter",
    "grouping",
    "layout"
  ]
}