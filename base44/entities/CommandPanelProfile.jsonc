{
  "name": "CommandPanelProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "panel_profile_id": {
      "type": "string",
      "description": "\u547d\u4ee4\u9762\u677f\u914d\u7f6e\u552f\u4e00\u6807\u8bc6"
    },
    "label": {
      "type": "string",
      "description": "\u663e\u793a\u540d"
    },
    "description": {
      "type": "string",
      "description": "\u8bf4\u660e\uff1a\u8fd9\u5957\u9762\u677f\u9002\u7528\u4e8e\u54ea\u79cd\u6e38\u620f\u5f62\u6001"
    },
    "panels": {
      "type": "array",
      "description": "\u540c\u5c4f\u53ef\u5e76\u5b58\u7684\u591a\u4e2a\u9762\u677f\u533a\uff08\u5982 SC2 \u5355\u4f4d\u9762\u677f + C&C \u5168\u5c40\u751f\u4ea7\u9762\u677f\uff09",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "panel_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "actor_collection",
              "global"
            ],
            "description": "actor_collection=\u770b\u9009\u62e9\u96c6\uff1bglobal=\u4e0d\u4f9d\u8d56\u9009\u4e2d\uff08\u9635\u8425\u751f\u4ea7\uff0f\u8d85\u6b66\u9762\u677f\uff09"
          },
          "actor_collection_key": {
            "type": "string",
            "description": "\u5f15\u7528\u7684 Actor \u96c6\u5408\u952e\uff08\u7531 ControlPlane \u67e5\u8be2\u56fe\u8f93\u51fa\uff09"
          },
          "actor_sort": {
            "type": "string",
            "enum": [
              "None",
              "SelectionOrder",
              "PrototypePriority",
              "AbilityCountDesc"
            ],
            "description": "\u53c2\u4e0e\u805a\u5408\u524d\u5bf9 Actor \u7684\u6392\u5e8f\u89c4\u5219"
          },
          "max_actors": {
            "type": [
              "integer",
              "null"
            ],
            "description": "\u53c2\u4e0e\u805a\u5408\u7684 Actor \u4e0a\u9650\uff1b1 \u7b49\u4ef7\u4e8e\u300c\u53ea\u770b\u6392\u5e8f\u540e\u7684\u7b2c\u4e00\u4e2a\u5355\u4f4d\u300d\uff0c\u7559\u7a7a\u4e3a\u5168\u4f53"
          },
          "required_all_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u6280\u80fd catalogTags \u5fc5\u987b\u5168\u90e8\u547d\u4e2d"
          },
          "blocked_any_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u6280\u80fd catalogTags \u547d\u4e2d\u4efb\u4e00\u5219\u6392\u9664"
          },
          "active_only": {
            "type": "boolean",
            "description": "\u53ea\u6536\u4e3b\u52a8\u6280\u80fd"
          },
          "aggregation_mode": {
            "type": "string",
            "enum": [
              "Intersect",
              "Union"
            ],
            "description": "Intersect=\u6240\u6709 Actor \u90fd\u62e5\u6709\u624d\u663e\u793a\uff1bUnion=\u4efb\u4e00\u62e5\u6709\u5373\u663e\u793a"
          },
          "aggregation_key_tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u805a\u5408\u5bf9\u9f50\u952e\uff1a\u6309\u8fd9\u4e9b catalogTags \u5224\u5b9a\u300c\u8de8\u5355\u4f4d\u662f\u5426\u540c\u4e00\u4e2a\u6280\u80fd\u300d\uff0c\u4e0e ability_id \u65e0\u5173"
          },
          "partial_coverage": {
            "type": "string",
            "enum": [
              "Hide",
              "Dim"
            ],
            "description": "Union \u6a21\u5f0f\u4e0b\u4ec5\u90e8\u5206 Actor \u62e5\u6709\u8be5\u6280\u80fd\u65f6\u7684\u5448\u73b0"
          },
          "semantic_profile_ref": {
            "type": "string",
            "description": "\u69fd\u4f4d\u8bed\u4e49\u7ec4\uff08AbilitySemanticProfile.profile_id\uff09\uff0c\u4ec5\u7528\u4e8e\u843d\u4f4d"
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u69fd\u4f4d\u5e03\u5c40\uff0c\u6309\u987a\u5e8f\uff08\u5982 Q / W / E / R \u6216 grid_0..n\uff09"
          },
          "role_slot_map": {
            "type": "array",
            "description": "\u8bed\u4e49\u89d2\u8272 \u2192 \u56fa\u5b9a\u69fd\u4f4d\u3002\u805a\u5408\u7ed3\u679c\u547d\u4e2d\u8be5\u8bed\u4e49\u65f6\u4f18\u5148\u843d\u5230\u6b64\u69fd",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slot": {
                  "type": "string"
                },
                "role_id": {
                  "type": "string"
                }
              },
              "required": [
                "slot"
              ]
            }
          },
          "fallback_sort": {
            "type": "string",
            "enum": [
              "None",
              "CatalogTagOrder",
              "AbilityIdAlpha",
              "SelectionOrder"
            ],
            "description": "\u672a\u547d\u4e2d\u8bed\u4e49\u7684\u6280\u80fd\uff0c\u6309\u6b64\u89c4\u5219\u6392\u5e8f\u540e\u586b\u5145\u5269\u4f59\u7a7a\u69fd"
          }
        },
        "required": [
          "panel_id",
          "source_kind",
          "aggregation_mode"
        ]
      }
    }
  },
  "required": [
    "panel_profile_id",
    "panels"
  ]
}