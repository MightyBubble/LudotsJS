{
  "name": "AttributeModifier",
  "type": "object",
  "properties": {
    "modifier_name": {
      "type": "string",
      "description": "\u4fee\u9970\u5668\u540d\u79f0"
    },
    "description": {
      "type": "string",
      "description": "\u4fee\u9970\u5668\u63cf\u8ff0"
    },
    "tag_path": {
      "type": "string",
      "description": "\u76d1\u542c\u7684\u6807\u7b7e\u8def\u5f84\uff08\u4f8b\u5982\uff1aStatus.Buff\uff09"
    },
    "tag_count_per_step": {
      "type": "number",
      "default": 1,
      "description": "\u6bcf\u591a\u5c11\u4e2a\u6807\u7b7e\u89e6\u53d1\u4e00\u6b21\u4fee\u9970"
    },
    "affected_attribute_id": {
      "type": "string",
      "description": "\u5f71\u54cd\u7684\u5c5e\u6027ID\uff08\u4f8b\u5982\uff1aattack_power, move_speed\uff09"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "add",
        "multiply",
        "flat_add",
        "final_multiply",
        "override"
      ],
      "default": "add",
      "description": "\u64cd\u4f5c\u65b9\u5f0f\uff1aadd(\u57fa\u7840\u52a0\u6cd5), multiply(\u57fa\u7840\u4e58\u6cd5), flat_add(\u56fa\u5b9a\u52a0\u6210), final_multiply(\u6700\u7ec8\u767e\u5206\u6bd4), override(\u8986\u76d6)"
    },
    "base_value": {
      "type": "number",
      "default": 0,
      "description": "\u57fa\u7840\u5f71\u54cd\u503c"
    },
    "curve_type": {
      "type": "string",
      "enum": [
        "linear",
        "exponential",
        "logarithmic",
        "custom"
      ],
      "default": "linear",
      "description": "\u66f2\u7ebf\u7c7b\u578b"
    },
    "curve_config": {
      "type": "object",
      "properties": {
        "exponential_base": {
          "type": "number",
          "description": "\u6307\u6570\u66f2\u7ebf\u7684\u5e95\u6570\uff08\u4f8b\u5982\uff1a1.5\uff09"
        },
        "logarithmic_base": {
          "type": "number",
          "description": "\u5bf9\u6570\u66f2\u7ebf\u7684\u5e95\u6570\uff08\u4f8b\u5982\uff1a10\uff09"
        },
        "custom_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag_count": {
                "type": "number"
              },
              "value": {
                "type": "number"
              }
            }
          },
          "description": "\u81ea\u5b9a\u4e49\u66f2\u7ebf\u7684\u6570\u636e\u70b9"
        }
      },
      "description": "\u66f2\u7ebf\u914d\u7f6e\u53c2\u6570"
    },
    "max_stacks": {
      "type": "number",
      "description": "\u6700\u5927\u53e0\u52a0\u6b21\u6570\uff08\u53ef\u9009\uff0c\u4e0d\u8bbe\u7f6e\u5219\u65e0\u9650\u5236\uff09"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u662f\u5426\u6fc0\u6d3b"
    },
    "priority": {
      "type": "number",
      "default": 0,
      "description": "\u4f18\u5148\u7ea7\uff08\u6570\u503c\u8d8a\u5927\u8d8a\u5148\u5e94\u7528\uff09"
    }
  },
  "required": [
    "modifier_name",
    "tag_path",
    "affected_attribute_id",
    "operation_type"
  ]
}