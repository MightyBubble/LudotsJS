{
  "name": "AbilityFormSet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "form_set_id": {
      "type": "string",
      "description": "\u6280\u80fd\u7ec4 ID\uff0c\u5bf9\u5e94 GAS/ability_form_sets.json \u7684 id\uff1b\u88ab AbilityFormSetRef.formSetId \u5f15\u7528"
    },
    "description": {
      "type": "string",
      "description": "\u5907\u6ce8\uff08\u4e0d\u5bfc\u51fa\uff09"
    },
    "routes": {
      "type": "array",
      "description": "\u6761\u4ef6\u8def\u7531\uff0c\u6309 priority \u7531\u9ad8\u5230\u4f4e\u5339\u914d\uff0c\u547d\u4e2d\u540e\u7528 slotOverrides \u8986\u76d6\u69fd\u4f4d",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requiredAll": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u5fc5\u987b\u5168\u90e8\u6301\u6709\u7684\u6807\u7b7e"
          },
          "blockedAny": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "\u6301\u6709\u4efb\u4e00\u5219\u4e0d\u5339\u914d\u7684\u6807\u7b7e"
          },
          "priority": {
            "type": "integer",
            "default": 0,
            "description": "\u4f18\u5148\u7ea7\uff0c\u6570\u503c\u8d8a\u5927\u8d8a\u5148\u5339\u914d"
          },
          "slotOverrides": {
            "type": "array",
            "description": "\u69fd\u4f4d\u8986\u76d6\uff0c\u81f3\u5c11\u4e00\u9879\uff1bslotIndex \u4e0d\u53ef\u91cd\u590d",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slotIndex": {
                  "type": "integer",
                  "minimum": 0
                },
                "abilityId": {
                  "type": "string"
                }
              },
              "required": [
                "slotIndex",
                "abilityId"
              ]
            }
          }
        },
        "required": [
          "priority",
          "slotOverrides"
        ]
      }
    }
  },
  "required": [
    "form_set_id",
    "routes"
  ]
}