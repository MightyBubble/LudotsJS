{
  "name": "Ability",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ability_id": {
      "type": "string",
      "description": "Ludots GAS/abilities.json id\uff1b\u5e73\u53f0\u4fdd\u7559 id\uff0c\u6545\u5b58\u4e3a ability_id"
    },
    "exec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clockId": {
          "type": "string"
        },
        "interruptAny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "callerParams": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "entries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "value"
                  ]
                }
              }
            },
            "required": [
              "entries"
            ]
          }
        },
        "items": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "EffectClip",
                  "TagClip",
                  "TagClipTarget",
                  "EffectSignal",
                  "EventSignal",
                  "GraphSignal",
                  "TagSignal",
                  "TagSignalTarget",
                  "InputGate",
                  "EventGate",
                  "TargetCollectionGate",
                  "End"
                ]
              },
              "tick": {
                "type": "integer"
              },
              "duration": {
                "type": "integer"
              },
              "clock": {
                "type": "string"
              },
              "tag": {
                "type": "string"
              },
              "template": {
                "type": "string"
              },
              "graph": {
                "type": "string"
              },
              "callerParamsIdx": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "payloadA": {
                "type": "integer"
              },
              "dispatchTarget": {
                "type": "string",
                "enum": [
                  "Default",
                  "Source",
                  "Target",
                  "TargetContext"
                ]
              }
            },
            "required": [
              "kind",
              "tick"
            ]
          }
        }
      },
      "required": [
        "clockId",
        "items"
      ]
    },
    "onActivateEffects": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string"
      }
    },
    "cooldown": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "valueAttribute": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "blockTags": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "requiredAll": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedAny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "catalogTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interactionContextProfile": {
      "type": "string"
    },
    "activationPrecondition": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "validationGraph": {
          "type": "string"
        }
      }
    },
    "toggleSpec": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "toggleTag": {
          "type": "string"
        },
        "activeEffects": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "deactivateExec": {
          "type": "object"
        }
      }
    },
    "targeting": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "castRangeCm": {
          "type": "number",
          "minimum": 0
        },
        "impactEffect": {
          "type": "string"
        }
      }
    },
    "presentation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string"
        },
        "iconGlyph": {
          "type": "string"
        },
        "accentColor": {
          "type": "string"
        },
        "hintText": {
          "type": "string"
        },
        "displayNameToken": {
          "type": "string"
        },
        "hintTextToken": {
          "type": "string"
        },
        "modeIconGlyphs": {
          "type": "object"
        },
        "modeHints": {
          "type": "object"
        },
        "modeHintTokens": {
          "type": "object"
        }
      }
    },
    "input": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string"
        },
        "heldPolicy": {
          "type": "string"
        },
        "castModeOverride": {
          "type": "string"
        },
        "autoTargetPolicy": {
          "type": "string"
        },
        "autoTargetRangeCm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "useRequirement": {
      "type": "string"
    },
    "showRequirement": {
      "type": "string"
    }
  },
  "required": [
    "ability_id",
    "exec"
  ]
}