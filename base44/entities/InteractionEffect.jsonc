          },
          "description": "\u53d1\u8d77\u8005\u5fc5\u987b\u62e5\u6709\u6240\u6709\u8fd9\u4e9b\u6807\u7b7e"
        },
        "not_has_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "\u53d1\u8d77\u8005\u4e0d\u80fd\u62e5\u6709\u8fd9\u4e9b\u6807\u7b7e"
        }
      }
    },
    "target_object_conditions": {
      "type": "object",
      "description": "\u76ee\u6807\u5bf9\u8c61\u5fc5\u987b\u6ee1\u8db3\u7684\u6807\u7b7e\u6761\u4ef6",
      "properties": {
