{
  "name": "UIScreenProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "screen_id": {
      "type": "string",
      "description": "UI Screen\uff08HUD \u5e03\u5c40\uff09\u7684\u7a33\u5b9a\u6807\u8bc6"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "skin": {
      "type": "object",
      "additionalProperties": false,
      "description": "\u76ae\u80a4 token\uff1a\u6539\u6570\u636e\u5373\u6539\u6240\u6709\u69fd\u4f4d\u9762\u677f\u5916\u89c2\uff0c\u65e0\u9700\u6539\u4ee3\u7801",
      "properties": {
        "panel_background": {
          "type": "string",
          "default": "#15171CF2"
        },
        "panel_border": {
          "type": "string",
          "default": "#424a55"
        },
        "header_text_color": {
          "type": "string",
          "default": "#E5E7EB"
        },
        "accent_color": {
          "type": "string",
          "default": "#7DD3FC"
        },
        "corner_radius": {
          "type": "integer",
          "default": 4
        }
      }
    },
    "slots": {
      "type": "array",
      "description": "\u5177\u540d\u69fd\u4f4d\uff1a\u8def\u7531\u7ed3\u679c\u6309 slot_id \u843d\u4f4d\uff1b\u69fd\u4f4d\u53ea\u63cf\u8ff0\u4f4d\u7f6e\u4e0e\u5c3a\u5bf8\uff0c\u4e0d\u7ed1\u5b9a\u9762\u677f\u5185\u5bb9",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "anchor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "horizontal": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ],
                "default": "center"
              },
              "vertical": {
                "type": "string",
                "enum": [
                  "top",
                  "center",
                  "bottom"
                ],
                "default": "bottom"
              },
              "offset_x": {
                "type": "number",
                "default": 0
              },
              "offset_y": {
                "type": "number",
                "default": 0
              }
            },
            "required": [
              "horizontal",
              "vertical"
            ]
          },
          "width": {
            "type": "integer",
            "default": 320
          }
        },
        "required": [
          "slot_id",
          "anchor"
        ]
      }
    }
  },
  "required": [
    "screen_id",
    "slots"
  ]
}