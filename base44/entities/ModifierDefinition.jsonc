{
  "name": "ModifierDefinition",
  "type": "object",
  "properties": {
    "modifier_name": {
      "type": "string",
      "description": "\u4fee\u9970\u5668\u540d\u79f0"
    },
    "description": {
      "type": "string",
      "description": "\u4fee\u9970\u5668\u63cf\u8ff0"
    },
    "curve_data_graph_id": {
      "type": "string",
      "description": "\u7528\u4e8e\u8ba1\u7b97\u4fee\u9970\u5e45\u5ea6\u7684\u66f2\u7ebfData Graph ID"
    },
    "curve_input_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "graph_blackboard_key": {
            "type": "string",
            "description": "Data Graph\u4e2d\u7684\u9ed1\u677f\u952e\u540d"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "tag_count",
              "attribute_key",
              "constant",
              "relation_entity_attribute",
              "relation_attribute",
              "relation_tag_count"
            ],
            "description": "\u8f93\u5165\u6765\u6e90\u7c7b\u578b"
          },
          "tag_path": {
            "type": "string",
            "description": "\u6807\u7b7e\u8def\u5f84\uff08\u5f53source_type\u4e3atag_count\u6216relation_tag_count\u65f6\uff09"
          },
          "attribute_id": {
            "type": "string",
            "description": "\u5c5e\u6027ID\uff08\u5f53source_type\u4e3aattribute_key\u65f6\uff09"
          },
          "attribute_key": {
            "type": "string",
            "description": "\u5c5e\u6027\u7684\u952e\u540d\uff08\u5f53source_type\u4e3aattribute_key\u65f6\uff09"
          },
          "constant_value": {
            "type": "number",
            "description": "\u5e38\u91cf\u503c\uff08\u5f53source_type\u4e3aconstant\u65f6\uff09"
          },
          "relation_id": {
            "type": "string",
            "description": "\u5173\u7cfbID\uff08\u5f53source_type\u4e3arelation_*\u65f6\uff09"
          }
        }
      },
      "description": "\u66f2\u7ebf\u56fe\u8f93\u5165\u6620\u5c04\u914d\u7f6e"
    },
    "target_type": {
      "type": "string",
      "enum": [
        "entity_attribute",
        "related_entity_attribute",
        "relation_attribute"
      ],
      "default": "entity_attribute",
      "description": "\u4fee\u9970\u76ee\u6807\u7c7b\u578b\uff1a\u5b9e\u4f53\u81ea\u8eab\u5c5e\u6027\u3001\u5173\u8054\u5b9e\u4f53\u5c5e\u6027\u3001\u5173\u7cfb\u5c5e\u6027"
    },
    "target_attribute_id": {
      "type": "string",
      "description": "\u76ee\u6807\u5c5e\u6027ID"
    },
    "output_key": {
      "type": "string",
      "description": "\u8f93\u51fa\u5230\u7684\u952e\u540d\uff08\u4ece\u76ee\u6807\u5c5e\u6027\u7684keys\u4e2d\u9009\u62e9\uff09"
    },
    "target_relation_id": {
      "type": "string",
      "description": "\u76ee\u6807\u5173\u7cfbID\uff08\u5f53target_type\u4e3arelated_entity_attribute\u6216relation_attribute\u65f6\uff09"
    },
    "max_trigger_times": {
      "type": "number",
      "description": "\u6700\u5927\u89e6\u53d1\u6b21\u6570\uff08\u53ef\u9009\uff0c\u4e0d\u8bbe\u7f6e\u5219\u65e0\u9650\u5236\uff09"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u662f\u5426\u6fc0\u6d3b"
    }
  },
  "required": [
    "modifier_name",
    "curve_data_graph_id",
    "curve_input_mappings",
    "target_attribute_id",
    "output_key"
  ]
}