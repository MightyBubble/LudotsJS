{
  "name": "Presenter",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "presenter_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": "string"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "persistence": {
          "type": "string",
          "enum": [
            "Scoped"
          ]
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "offset"
      ]
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inline": {
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "definitionId": {
            "type": "string"
          },
          "scopeTag": {
            "type": "string",
            "description": "\u547d\u540d\u4f5c\u7528\u57df\u6807\u7b7e\uff1b\u5bfc\u51fa\u5230 Ludots \u540e\u7531 PresenterScopeTagRegistry \u89e3\u6790\u4e3a\u6574\u6570 ID"
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transform": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "localPosition": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "localRotation": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "localScale": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "children_mode": {
            "type": "string",
            "enum": [
              "inherit",
              "override"
            ],
            "default": "inherit"
          },
          "runtime_behaviors": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "definitionId"
        ]
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "paramDefaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paramKey": {
            "type": "string"
          },
          "lane": {
            "type": "string",
            "enum": [
              "Float",
              "Int",
              "Vector"
            ]
          },
          "floatValue": {
            "type": "number"
          },
          "intValue": {
            "type": "integer"
          },
          "vectorValue": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "paramKey",
          "lane"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "object"
          },
          "condition": {
            "type": "object"
          },
          "command": {
            "type": "object"
          }
        }
      }
    }
  },
  "required": [
    "presenter_id"
  ]
}
