{
  "name": "MapConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "map_id": {
      "type": "string",
      "description": "Ludots MapConfig.Id"
    },
    "label": {
      "type": "string",
      "description": "\u7f16\u8f91\u5668\u663e\u793a\u540d\u79f0"
    },
    "description": {
      "type": "string",
      "description": "\u7f16\u8f91\u5668\u8bf4\u660e"
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "project",
        "workspace"
      ],
      "default": "project"
    },
    "workspace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "visual_heightmap_asset": {
      "type": "string"
    },
    "structure_collision_asset": {
      "type": "string"
    },
    "structure_aware_grounding": {
      "type": "boolean",
      "default": false
    },
    "structure_aware_navigation": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "template": {
            "type": "string",
            "description": "EntitySpawnData.Template"
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "overrides": {
            "type": "object"
          },
          "performer_param_overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "param_key": {
                  "type": "string"
                },
                "lane": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "float_value": {
                  "type": "number"
                },
                "int_value": {
                  "type": "integer"
                },
                "vector_value": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              },
              "required": [
                "param_key"
              ]
            }
          }
        },
        "required": [
          "instance_id",
          "template",
          "position"
        ]
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "default": "default"
          },
          "spatial_type": {
            "type": "string",
            "enum": [
              "Grid",
              "HexGrid",
              "NodeGraph"
            ],
            "default": "Grid"
          },
          "width_in_macro_tiles": {
            "type": "integer",
            "default": 64
          },
          "height_in_macro_tiles": {
            "type": "integer",
            "default": 64
          },
          "grid_cell_size_cm": {
            "type": "integer",
            "default": 100
          },
          "hex_edge_length_cm": {
            "type": "integer",
            "default": 400
          },
          "chunk_size_cells": {
            "type": "integer",
            "default": 64
          },
          "loaded_chunk_capacity": {
            "type": "integer",
            "default": 0
          },
          "data_file": {
            "type": "string"
          },
          "visual_heightmap_asset": {
            "type": "string"
          },
          "structure_collision_asset": {
            "type": "string"
          },
          "structure_aware_grounding": {
            "type": "boolean",
            "default": false
          },
          "structure_aware_navigation": {
            "type": "boolean",
            "default": false
          },
          "navigation_enabled": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "name",
          "spatial_type",
          "width_in_macro_tiles",
          "height_in_macro_tiles",
          "grid_cell_size_cm",
          "hex_edge_length_cm",
          "chunk_size_cells",
          "loaded_chunk_capacity",
          "structure_aware_grounding",
          "structure_aware_navigation",
          "navigation_enabled"
        ]
      }
    },
    "visual_heightmap": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string"
        },
        "board_name": {
          "type": "string"
        },
        "default_layer_index": {
          "type": "integer"
        }
      },
      "required": [
        "asset",
        "board_name",
        "default_layer_index"
      ]
    },
    "trigger_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "MapConfig.TriggerTypes\uff1b\u7531\u52fe\u9009\u7684\u5173\u5361\u84dd\u56fe\u5199\u5165\u7684 C# Trigger \u7c7b\u578b\u540d"
    },
    "default_camera": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "virtual_camera_id": {
          "type": "string"
        },
        "target_x_cm": {
          "type": [
            "number",
            "null"
          ]
        },
        "target_y_cm": {
          "type": [
            "number",
            "null"
          ]
        },
        "yaw": {
          "type": [
            "number",
            "null"
          ]
        },
        "pitch": {
          "type": [
            "number",
            "null"
          ]
        },
        "distance_cm": {
          "type": [
            "number",
            "null"
          ]
        },
        "fov_y_deg": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "selection_interaction": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "default_mode": {
          "type": "string",
          "enum": [
            "screen_box",
            "screen_lasso",
            "world_box",
            "world_lasso"
          ],
          "default": "screen_box"
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "screen_box": {
              "$ref": "#/$defs/selectionStyle"
            },
            "screen_lasso": {
              "$ref": "#/$defs/selectionStyle"
            },
            "world_box": {
              "$ref": "#/$defs/selectionStyle"
            },
            "world_lasso": {
              "$ref": "#/$defs/selectionStyle"
            }
          }
        }
      },
      "required": [
        "enabled",
        "default_mode",
        "modes"
      ]
    }
  },
  "$defs": {
    "selectionStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "stroke_color": {
          "type": "string",
          "default": "#7DD3FC"
        },
        "fill_color": {
          "type": "string",
          "default": "#38BDF833"
        },
        "line_width": {
          "type": "number",
          "minimum": 1,
          "default": 2
        }
      },
      "required": [
        "enabled",
        "stroke_color",
        "fill_color",
        "line_width"
      ]
    }
  },
  "required": [
    "map_id",
    "structure_aware_grounding",
    "structure_aware_navigation",
    "tags",
    "metadata",
    "entities",
    "boards",
    "trigger_types"
  ]
}