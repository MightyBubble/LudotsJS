{
  "name": "ControlPlaneProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile_id": {
      "type": "string",
      "description": "\u63a7\u5236\u5e73\u9762\u914d\u7f6e\u552f\u4e00\u6807\u8bc6"
    },
    "name": {
      "type": "string",
      "description": "\u663e\u793a\u540d\u79f0"
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "LocalAvatar",
            "ContextEntity"
          ]
        },
        "contextKey": {
          "type": "string"
        }
      },
      "required": [
        "kind"
      ]
    },
    "controlRelations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u4ece\u951a\u70b9\u904d\u5386\u7684\u63a7\u5236\u5173\u7cfb\u7c7b\u578b"
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "collectionKey": {
            "type": "string"
          },
          "access": {
            "type": "string",
            "enum": [
              "FullyControlled",
              "DirectGrant"
            ]
          },
          "includeAnchor": {
            "type": "boolean",
            "default": false
          },
          "primaryPolicy": {
            "type": "string",
            "enum": [
              "FirstMember",
              "Anchor"
            ]
          }
        },
        "required": [
          "collectionKey",
          "access",
          "includeAnchor",
          "primaryPolicy"
        ]
      }
    }
  },
  "required": [
    "profile_id",
    "name",
    "anchor",
    "controlRelations",
    "projections"
  ]
}