            "enum": [
              "AssetBinding",
              "AttributeBinding",
              "TagBinding",
              "Animator",
              "Attachment",
              "Sound",
              "Material",
              "Spline"
            ]
          },
          "activeByDefault": {
            "type": "boolean"
          },
          "activationCondition": {
            "type": "object"
          },
          "assetBinding": {
            "type": "object",
            "properties": {
              "assetKind": {
                "type": "string"
              },
              "assetId": {
                "type": "string"
              },
              "renderPath": {
                "type": "string"
              },
              "mobility": {
                "type": "string"
              },
              "localOffset": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "localRotation": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "localScale": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "scaleParamKey": {
                "type": "string"
              },
              "colorParamKey": {
                "type": "string"
              },
              "materialParamKey": {
                "type": "string"
              },
              "assetSwapParamKey": {
                "type": "string"
              },
              "visibilityParamKey": {
                "type": "string"
              },
              "assetSwapTable": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "attributeBinding": {
            "type": "object",
            "properties": {
              "attributeId": {
                "type": "string"
              },
              "targetParamKey": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "thresholds": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "tagBinding": {
            "type": "object",
            "properties": {
              "tagId": {
                "type": "string"
              },
              "targetParamKey": {
                "type": "string"
              },
              "invertLogic": {
                "type": "boolean"
              }
            }
          },
          "animator": {
            "type": "object",
            "properties": {
              "animatorControllerId": {
                "type": "string"
              },
              "animationProfileId": {
                "type": "string"
              },
              "speedParamKey": {
                "type": "string"
              },
              "stateParamKey": {
                "type": "string"
              }
            }
          },
          "attachment": {
            "type": "object",
            "properties": {
              "boneId": {
                "type": "integer"
              },
              "offset": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "rotationOffset": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "inheritScale": {
                "type": "boolean"
              }
            }
          },
          "sound": {
            "type": "object",
            "properties": {
              "soundAssetId": {
                "type": "string"
              },
              "loop": {
                "type": "boolean"
              },
              "volume": {
                "type": "number"
              },
              "volumeParamKey": {
                "type": "string"
              }
            }
          },
          "material": {
            "type": "object",
            "properties": {
              "baseMaterialId": {
                "type": "string"
              },
              "materialSwapParamKey": {
                "type": "string"
              },
              "swapTable": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "spline": {
            "type": "object",
            "properties": {
              "splineAssetId": {
                "type": "string"
              },
              "usage": {
                "type": "string"
              },
              "widthParamKey": {
                "type": "string"
              },
              "colorParamKey": {
                "type": "string"
              },
              "speedParamKey": {
                "type": "string"
              },
              "progressParamKey": {
                "type": "string"
              },
              "loop": {
                "type": "boolean"
              },
              "pingPong": {
                "type": "boolean"
              },
              "waypointEventId": {
                "type": "integer"
              }
            }
          }
        },
        "required": [
          "slot",
          "kind"
        ]
      }
    },
    "paramDefaults": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paramValue"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "object"
          },
          "condition": {
            "type": "object"
          },
          "command": {
            "type": "object"
          }
        }
      }
    },
    "instanced_batches": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "PerformerDefinition.InstancedBatches"
    },
    "surface": {
      "type": [
        "object",
        "null"
      ],
      "description": "PerformerDefinition.Surface"
    }
  },
  "$defs": {
    "paramValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paramKey": {
          "type": "string"
        },
        "lane": {
          "type": "string",
          "enum": [
            "Float",
            "Int",
            "Vector"
          ]
        },
        "floatValue": {
          "type": "number"
        },
        "intValue": {
          "type": "integer"
        },
        "vectorValue": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "paramKey",
        "lane"
      ]
    }
  },
  "required": [
    "performer_id"
  ]
}