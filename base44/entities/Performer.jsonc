{
  "name": "Performer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "performer_id": {
      "type": "string",
      "description": "Ludots performers.json id / PerformerDefinition.Key"
    },
    "label": {
      "type": "string",
      "description": "\u7f16\u8f91\u5668\u663e\u793a\u540d\uff0c\u4e0d\u5bfc\u51fa"
    },
    "description": {
      "type": "string",
      "description": "\u7f16\u8f91\u5668\u8bf4\u660e\uff0c\u4e0d\u5bfc\u51fa"
    },
    "extends": {
      "type": "string",
      "description": "PerformerDefinition.Extends"
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "definition_id": {
            "type": "string",
            "description": "Performer performer_id"
          },
          "scope_tag": {
            "type": "integer"
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transform": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "local_position": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "local_rotation": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "description": "XYZ \u6b27\u62c9\u89d2\uff0c\u5355\u4f4d\u5ea6"
                  },
                  "local_scale": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "params": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/paramValue"
                }
              }
            },
            "description": "LudotsJS \u5b50\u5b9e\u4f8b\u8986\u76d6\u5951\u7ea6\uff1bC# \u5bf9\u9f50\u524d\u7531 JS runtime \u6d88\u8d39"
          },
          "param_overrides": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/paramValue"
            },
            "description": "\u65e7\u7248\u517c\u5bb9\u5b57\u6bb5\uff1b\u65b0\u914d\u7f6e\u5199\u5165 overrides.params"
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "\u5f53\u524d\u7236\u5b9e\u4f8b\u5185\u663e\u5f0f\u7269\u5316\u7684\u9012\u5f52\u5b50\u5b9e\u4f8b\u5c42\u7ea7\uff1b\u7528\u4e8e\u6392\u5e8f\u4e0e\u6362\u7236\u7ea7"
          }
        },
        "required": [
          "definition_id"
        ]
      }
    },
    "default_color": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "default_lifetime": {
      "type": [
        "number",
        "null"
      ]
    },
    "default_font_size": {
      "type": [
        "integer",
        "null"
      ]
    },
    "position_offset": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "position_y_drift_per_second": {
      "type": [
        "number",
        "null"
      ]
    },
    "alpha_fade_over_lifetime": {
      "type": "boolean",
      "default": false
    },
    "world_text_mode": {
      "type": "string",
      "description": "WorldHudValueMode"
    },
    "visibility_inline": {
      "type": "string"
    },
    "visibility_graph_program_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "required_attribute_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "slot": {
            "type": "string"
          },
          "kind": {
