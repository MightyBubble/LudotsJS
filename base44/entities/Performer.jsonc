{
  "name": "Performer",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "performer_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "extends": {
      "type": "string"
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "persistence": {
          "type": "string",
          "enum": [
            "Scoped"
          ]
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        }
      },
      "required": [
        "offset"
      ]
    },
    "visibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inline": {
          "type": "string"
        }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "definition_id": {
            "type": "string"
          },
          "scope_tag": {
            "type": "string",
            "description": "\u547d\u540d\u4f5c\u7528\u57df\u6807\u7b7e\uff1b\u5bfc\u51fa\u5230 Ludots \u540e\u7531 PerformerScopeTagRegistry \u89e3\u6790\u4e3a\u6574\u6570 ID"
          },
          "children_mode": {
            "type": "string",
            "enum": [
              "inherit",
              "override"
            ],
            "default": "inherit"
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "transform": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "local_position": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "local_rotation": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "local_scale": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "params": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          "param_overrides": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "runtime_behaviors": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/behavior"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "definition_id"
        ]
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      }
    },
    "paramDefaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "paramKey": {
            "type": "string"
          },
          "lane": {
            "type": "string",
            "enum": [
              "Float",
              "Int",
              "Vector"
            ]
          },
          "floatValue": {
            "type": "number"
          },
          "intValue": {
            "type": "integer"
          },
          "vectorValue": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "paramKey",
          "lane"
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "object"
          },
          "condition": {
            "type": "object"
          },
          "command": {
            "type": "object"
          }
        }
      }
    }
  },
  "$defs": {
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slot": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "AssetBinding",
            "AttributeBinding",
            "TagBinding",
            "Animator",
            "Attachment",
            "Sound",
            "Material",
            "Spline",
            "Grounding",
            "MinimapMarker",
            "WorldText",
            "SurfaceSource",
            "InstancedBatch"
          ]
        },
        "activeByDefault": {
          "type": "boolean"
        },
        "activationCondition": {
          "type": [
            "object",
            "null"
          ]
        },
        "assetBinding": {
          "type": [
            "object",
            "null"
          ]
        },
        "attributeBinding": {
          "type": [
            "object",
            "null"
          ]
        },
        "tagBinding": {
          "type": [
            "object",
            "null"
          ]
        },
        "animator": {
          "type": [
            "object",
            "null"
          ]
        },
        "attachment": {
          "type": [
            "object",
            "null"
          ]
        },
        "sound": {
          "type": [
            "object",
            "null"
          ]
        },
        "material": {
          "type": [
            "object",
            "null"
          ]
        },
        "spline": {
          "type": [
            "object",
            "null"
          ]
        },
        "grounding": {
          "type": [
            "object",
            "null"
          ]
        },
        "minimapMarker": {
          "type": [
            "object",
            "null"
          ]
        },
        "worldText": {
          "type": [
            "object",
            "null"
          ]
        },
        "surfaceSource": {
          "type": [
            "object",
            "null"
          ]
        },
        "instancedBatch": {
          "type": [
            "object",
            "null"
          ]
        },
        "style": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "color": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "alphaPolicy": {
              "type": "string"
            }
          }
        },
        "motion": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "yDriftPerSecond": {
              "type": "number"
            }
          }
        }
      },
      "required": [
        "slot",
        "kind"
      ]
    }
  },
  "required": [
    "performer_id"
  ]
}